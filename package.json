{
  "name":"episode-split-studio-mac",
  "version":"0.1.0",
  "private":true,
  "description":"拆集工作台单体 Mac 应用",
  "main":"main.js",
  "scripts":{"start":"electron .","dist:mac":"electron-builder --mac dmg --arm64 --publish never"},
  "devDependencies":{"electron":"^39.0.0","electron-builder":"^26.0.0","ffmpeg-static":"^5.2.0","@ffprobe-installer/ffprobe":"^2.1.2"},
  "build":{
    "appId":"com.yunying.episodesplit",
    "productName":"拆集工作台",
    "directories":{"output":"release"},
    "files":["main.js","preload.js","web/**/*","package.json"],
    "extraResources":[{"from":"build/episode-agent","to":"episode-agent"},{"from":"build/bin","to":"bin"}],
    "mac":{"category":"public.app-category.video","target":[{"target":"dmg","arch":["arm64"]}],"hardenedRuntime":true},
    "dmg":{"title":"拆集工作台"}
  }
}
